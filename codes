class SimpleSignalChart {
    constructor(canvasId) {
        this.canvas = document.getElementById(canvasId);
        this.ctx = this.canvas.getContext("2d");
        this.data = [];
        window.addEventListener("resize", () => this.draw());
    }
    setData(rssiHistory) {
        this.data = rssiHistory.map(pt => pt.y);

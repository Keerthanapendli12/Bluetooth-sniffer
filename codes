    `;

    const decodedFields = decodePayload(dev.raw);
    if (decodedFields.length === 0) {
        decodedDetails.innerHTML = `<div class="detail-row empty">No decodable AD fields.</div>`;
    } else {
        let decHtml = "";
        decodedFields.forEach(f => {
            decHtml += `<div class="detail-row"><span class="detail-label">${f.label}</span><span class="detail-val">${f.val}</span></div>`;

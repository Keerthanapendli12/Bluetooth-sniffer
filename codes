function renderTable() {
    const searchVal = searchInput.value.toLowerCase().trim();
    const rssiLimit = parseInt(rssiThreshold.value);
    
    const sortedDevs = Array.from(devices.values())
        .filter(d => {
            const matchesSearch = d.mac.toLowerCase().includes(searchVal) || d.name.toLowerCase().includes(searchVal);
            return matchesSearch && d.rssi >= rssiLimit;
        })
        .sort((a, b) => b.rssi - a.rssi);
        
    document.getElementById("visible-count").innerText = `Showing ${sortedDevs.length} devices`;

    if (sortedDevs.length === 0) {
        bodyTable.innerHTML = `<tr class="empty-row"><td colspan="6">Waiting for BLE packets...</td></tr>`;
        return;
    }

    let rowsHtml = "";
    sortedDevs.forEach(dev => {
        const timeDiff = Math.max(0, Math.floor((Date.now() - dev.lastSeen) / 1000));
        let timeStr = timeDiff === 0 ? "Just now" : `${timeDiff}s ago`;
        let rssiClass = dev.rssi < -80 ? "rssi-weak" : (dev.rssi < -60 ? "rssi-medium" : "rssi-strong");
        let rowClass = dev.mac === selectedMac ? "class='selected'" : "";
        let icon = dev.type === "Beacon" ? "📡" : (dev.type === "Wearable" ? "⌚" : (dev.type === "Sensor" ? "🌡️" : "📱"));
        
        rowsHtml += `
            <tr ${rowClass} onclick="selectDevice('${dev.mac}')">
                <td><strong>${escapeHtml(dev.name)}</strong></td>
                <td><code class="mono">${dev.mac}</code></td>
                <td><span class="rssi-badge ${rssiClass}">${dev.rssi} dBm</span></td>
                <td><span class="device-type">${icon} ${dev.type}</span></td>
                <td>${dev.packetCount}</td>
                <td>${timeStr}</td>
            </tr>
        `;
    });
    bodyTable.innerHTML = rowsHtml;
}

function escapeHtml(str) { return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }


        const oldestVal = oldRssiHistory[0];
        const timeDiffSec = (now - oldestVal.t) / 1000;
        if (timeDiffSec > 0 && timeDiffSec <= 8) {
            const rssiDelta = packet.rssi - oldestVal.y;
            if (rssiDelta >= 15) {
                triggerAlert(
                    "approach",
                    dev.mac,
                    "⚠️ RAPID PROXIMITY EVENT",
                    `Device "${dev.name}" is approaching rapidly! Signal rose +${rssiDelta} dBm in ${timeDiffSec.toFixed(1)}s.`,
                    "Educational explanation: A sudden increase in RSSI (signal strength) indicates that the physical transmitter is moving fast towards the sniffer, which can trigger immediate logging rules.",
                    true
                );
            }
        }
    }

    renderTable();
    updateStats();
    
    if (selectedMac === mac) {
        updateInspector(dev);
        appendChartData(now, packet.rssi);
    }
}

function triggerAlert(alertType, mac, title, desc, edu, isWarning) {
    const alertId = `${alertType}_${mac}`;
    
    // Throttling to prevent alert spamming (trigger same alert max once every 30s)
    if (activeAlerts.has(alertId)) {
        const lastTime = activeAlerts.get(alertId).time;
        if (Date.now() - lastTime < 30000) {
            activeAlerts.get(alertId).time = Date.now();
            return;
        }
    }
    
    activeAlerts.set(alertId, {
        time: Date.now(),
        mac: mac,
        title: title,
        desc: desc,
        edu: edu,
        isWarning: isWarning
    });
    
    renderAlerts();
}

function renderAlerts() {
    if (activeAlerts.size === 0) {
        alertsContainer.style.display = "none";
        return;
    }
    
    alertsContainer.style.display = "block";
    
    const sortedAlerts = Array.from(activeAlerts.values())
        .sort((a, b) => b.time - a.time)
        .slice(0, 3); // Display only the 3 most recent alerts
        
    let html = "";
    sortedAlerts.forEach(alert => {
        const warningClass = alert.isWarning ? "alert-item warning" : "alert-item";
        const timeStr = new Date(alert.time).toLocaleTimeString();
        html += `
            <div class="${warningClass}">
                <div class="alert-header">
                    <span class="alert-title">${alert.title}</span>
                    <span class="alert-time">${timeStr}</span>
                </div>
                <div class="alert-desc">${alert.desc}</div>
                <div class="alert-edu">${alert.edu}</div>
            </div>
        `;
    });
    securityAlertsList.innerHTML = html;
}

function classifyDevice(packet) {
    const name = (packet.name || "").toLowerCase();
    const raw = packet.raw || "";
    if (raw.includes("4C000215") || raw.includes("0303AAFE") || raw.includes("1AFF4C000215") || raw.includes("4C001219")) return "Beacon";
    if (name.includes("watch") || name.includes("fitbit") || name.includes("band") || name.includes("buds") || name.includes("smart")) return "Wearable";
    if (name.includes("temp") || name.includes("hum") || name.includes("sensor") || name.includes("tag") || name.includes("batt")) return "Sensor";
    if (name.includes("iphone") || name.includes("galaxy") || name.includes("phone") || name.includes("android")) return "Mobile";
    return "BLE Device";
}

function decodePayload(hexStr) {
    if (!hexStr || hexStr.length === 0) return [];
    const fields = [];
    let idx = 0;
    const bytes = [];
    for (let i = 0; i < hexStr.length; i += 2) {
        bytes.push(parseInt(hexStr.substring(i, i + 2), 16));
    }
    
    while (idx < bytes.length) {
        const len = bytes[idx];
        if (len === 0 || idx + len >= bytes.length) break;
        const type = bytes[idx + 1];
        const data = bytes.slice(idx + 2, idx + 1 + len);
        let label = "Unknown Type";
        let val = "";
        
        switch (type) {
            case 0x01:
                label = "Flags";
                const flags = data[0];
                const list = [];
                if (flags & 0x01) list.push("LE Limited");
                if (flags & 0x02) list.push("LE General");
                if (flags & 0x04) list.push("BR/EDR Not Supported");
                val = list.join(" | ") || `0x${flags.toString(16)}`;
                break;
            case 0x03:
                label = "16-bit Service UUIDs";
                const uuids16 = [];
                for (let i = 0; i < data.length; i += 2) {
                    if (i + 1 < data.length) {
                        const uuid = ((data[i+1] << 8) | data[i]).toString(16).toUpperCase().padStart(4, '0');
                        uuids16.push(`0x${uuid}`);
                    }
                }
                val = uuids16.join(", ");
                break;
            case 0x08:
            case 0x09:
                label = "Local Name";
                val = String.fromCharCode.apply(null, data);
                break;
            case 0x0A:
                label = "Tx Power Level";
                const pwr = data[0] > 127 ? data[0] - 256 : data[0];
                val = `${pwr} dBm`;
                break;
            case 0x16: // Service Data AD Type (contains battery/sensor data)
                label = "Service Data (16-bit)";
                if (data.length >= 2) {
                    const serviceUuid = (data[1] << 8) | data[0];
                    const serviceDataBytes = data.slice(2);
                    val = `Service: 0x${serviceUuid.toString(16).toUpperCase().padStart(4, '0')}`;
                    if (serviceUuid === 0x180F && serviceDataBytes.length >= 1) {
                        val += `<br><strong>Battery Level: ${serviceDataBytes[0]}%</strong>`;
                    } else if (serviceUuid === 0x1809 && serviceDataBytes.length >= 1) {
                        val += `<br><strong>Temperature: ${serviceDataBytes[0]}°C</strong>`;
                    } else if (serviceDataBytes.length > 0) {
                        val += `<br>Data: ${bytesToHex(serviceDataBytes)}`;
                    }
                } else {
                    val = bytesToHex(data);
                }
                break;
            case 0xFF:
                label = "Manufacturer Data";
                if (data.length >= 2) {
                    const companyId = (data[1] << 8) | data[0];
                    let compName = mapCompanyId(companyId);
                    let subHex = bytesToHex(data.slice(2));
                    val = `Company: ${compName} (0x${companyId.toString(16).toUpperCase().padStart(4, '0')})`;
                    
                    if (companyId === 0x004C && data[2] === 0x02 && data[3] === 0x15) {
                        label = "iBeacon Packet";
                        const uuid = bytesToHex(data.slice(4, 20)).match(/.{1,8}/g).join('-');
                        const major = (data[20] << 8) | data[21];
                        const minor = (data[22] << 8) | data[23];
                        const txPower = data[24] > 127 ? data[24] - 256 : data[24];
                        val = `UUID: ${uuid}<br>Major: ${major}<br>Minor: ${minor}<br>Tx Power: ${txPower} dBm`;
                    } else if (companyId === 0x004C && data[2] === 0x12 && data[3] === 0x19) {
                        label = "Find My Tracking Telemetry";
                        val = `Apple Find My beacon tracking broadcast detected.<br>Public Key: <span class="mono">${bytesToHex(data.slice(4))}</span>`;
                    } else if (subHex.length > 0) {
                        val += `<br>Payload: <span class="mono">${subHex}</span>`;
                    }
                } else {
                    val = bytesToHex(data);
                }
                break;
            default:
                label = `Type 0x${type.toString(16).toUpperCase().padStart(2, '0')}`;
                val = bytesToHex(data);
                break;
        }
        fields.push({ label, val });
        idx += len + 1;
    }
    return fields;
}

function bytesToHex(bytes) { return bytes.map(b => b.toString(16).padStart(2, '0').toUpperCase()).join(' '); }
function mapCompanyId(id) {
    const companies = { 0x004C: "Apple", 0x0006: "Microsoft", 0x00E0: "Google", 0x0059: "Nordic", 0x0075: "Samsung" };
    return companies[id] || "Unknown Corp";
}


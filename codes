        decodedDetails.innerHTML = decHtml;
    }

    let hexView = "";
    for (let i = 0; i < dev.raw.length; i += 2) { hexView += dev.raw.substring(i, i + 2) + " "; }
    rawPacketHex.innerText = hexView.trim() || "-- -- -- --";

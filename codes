class MyAdvertisedDeviceCallbacks: public BLEAdvertisedDeviceCallbacks {
    void onResult(BLEAdvertisedDevice advertisedDevice) {
      String mac = advertisedDevice.getAddress().toString().c_str();
      mac.toUpperCase();
      int rssi = advertisedDevice.getRSSI();
      
      String name = advertisedDevice.getName().c_str();
      if (name.length() == 0) {
        name = "Unknown";
      }
      
      String rawHex = "";
      uint8_t* payload = advertisedDevice.getPayload();
      size_t len = advertisedDevice.getPayloadLength();
      for (size_t i = 0; i < len; i++) {
        char temp[3];
        sprintf(temp, "%02X", payload[i]);
        rawHex += temp;
      }
      
      // Get address type (0 = Public, 1 = Random/Private)
      int addrType = (int)advertisedDevice.getAddressType();
      
      // Construct packet JSON
      String json = "{";
      json += "\"mac\":\"" + mac + "\",";
      json += "\"rssi\":" + String(rssi) + ",";
      json += "\"raw\":\"" + rawHex + "\",";
      json += "\"len\":" + String(len) + ",";
      json += "\"name\":\"" + name + "\",";
      json += "\"addrType\":" + String(addrType);
      json += "}";
      
      // Broadcast to WebSocket clients
      webSocket.broadcastTXT(json);
    }
};

// ==========================================
// Setup and Initialization
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  // Configure Access Point (AP) mode
  Serial.println("Configuring Access Point...");
  WiFi.softAP(ap_ssid, ap_pass);
  IPAddress myIP = WiFi.softAPIP();
  Serial.print("AP IP address: ");
  Serial.println(myIP);

  // Initialize mDNS Local Domain (blesniffer.local)
  if (!MDNS.begin("blesniffer")) {
    Serial.println("Error setting up MDNS responder!");
  } else {
    Serial.println("mDNS responder active. Access at: http://blesniffer.local");
  }

  // Handle static page routing (from PROGMEM - NO SPIFFS REQUIRED)
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", index_html);
  });
  
  server.on("/style.css", HTTP_GET, []() {
    server.send_P(200, "text/css", style_css);
  });
  
  server.on("/app.js", HTTP_GET, []() {
    server.send_P(200, "application/javascript", app_js);
  });

  server.begin();
  Serial.println("HTTP server started.");

  // WebSocket Server on Port 81
  webSocket.begin();
  webSocket.onEvent(onWebSocketEvent);
  Serial.println("WebSocket server active on port 81.");

  // BLE initialization
  BLEDevice::init("ESP32_BLE_Sniffer");
  pBLEScan = BLEDevice::getScan();
  pBLEScan->setAdvertisedDeviceCallbacks(new MyAdvertisedDeviceCallbacks());
  pBLEScan->setActiveScan(true); 
  pBLEScan->setInterval(100);
  pBLEScan->setWindow(99);
}

// ==========================================
// Main Loop
// ==========================================
void loop() {
  server.handleClient();
  webSocket.loop();

  if (isScanning) {
    pBLEScan->start(1, false); // Scan for 1 second, non-blocking
    pBLEScan->clearResults();   // Clear buffer memory
  } else {
    delay(100);
  }
}

// WebSocket Event Handler (Obeying dashboard pause/resume commands)
void onWebSocketEvent(uint8_t num, WStype_t type, uint8_t * payload, size_t length) {
  if (type == WStype_TEXT) {
    String cmd = String((char*)payload).substring(0, length);
    Serial.printf("[%u] Received command: %s\n", num, cmd.c_str());
    if (cmd == "pause") {
      isScanning = false;
      Serial.println("BLE Sniffer scan execution paused.");
    } else if (cmd == "resume") {
      isScanning = true;
      Serial.println("BLE Sniffer scan execution resumed.");
    }
  }
}

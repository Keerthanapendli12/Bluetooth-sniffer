      }
      
      if (index == -1) {
        // Register new device if limit is not reached
        if (deviceCount < MAX_LOGGED_DEVICES) {
          index = deviceCount;
          deviceLogs[index].mac = mac;
          deviceLogs[index].firstSeen = now;
          deviceLogs[index].rssiCount = 0;
          deviceCount++;
          Serial.println("New device detected: " + mac);
        } else {
          return; // Registry full
        }
      }
      
      // Update device parameters
      deviceLogs[index].lastSeen = now;
      deviceLogs[index].decodedData = decodeServiceData(advertisedDevice);
      
      // Update RSSI History (shifting array to keep last 10 entries)
      if (deviceLogs[index].rssiCount < 10) {
        deviceLogs[index].rssiHistory[deviceLogs[index].rssiCount] = rssi;
        deviceLogs[index].rssiCount++;
      } else {
        // Shift history left
        for (int j = 0; j < 9; j++) {
          deviceLogs[index].rssiHistory[j] = deviceLogs[index].rssiHistory[j + 1];
        }
        deviceLogs[index].rssiHistory[9] = rssi;
      }
    }
};

// ==========================================
// Setup
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("\nInitializing Passive Logger System...");

  // Initialize SPIFFS
  if (!SPIFFS.begin(true)) {
    Serial.println("Error: SPIFFS Partition not found or failed to initialize!");
    Serial.println("Ensure Tools -> Partition Scheme is set to a scheme with SPIFFS (e.g. Default with SPIFFS or Huge APP).");
    Serial.println("Running logger in RAM-only mode (logs will not be saved to flash).");
    spiffsActive = false;
  } else {
    Serial.println("SPIFFS mounted successfully.");
    spiffsActive = true;
    
    // Clear existing logs from previous run (removes old logs on boot)
    if (SPIFFS.exists(LOG_FILE_PATH)) {
      SPIFFS.remove(LOG_FILE_PATH);
    }
  }

  // Initialize BLE in Passive Mode (always runs even if SPIFFS is missing)
  BLEDevice::init("ESP32_BLE_Logger");
  pBLEScan = BLEDevice::getScan();
  if (pBLEScan != nullptr) {
    pBLEScan->setAdvertisedDeviceCallbacks(new MyAdvertisedDeviceCallbacks());
    pBLEScan->setActiveScan(false); // PASSIVE SCANNING (listen-only, low-power)
    pBLEScan->setInterval(100);
    pBLEScan->setWindow(99);
    Serial.println("BLE Scanner initialized successfully.");
  } else {
    Serial.println("Error: Failed to initialize BLE Scanner!");
  }
}

// ==========================================
// Loop Execution
// ==========================================
void loop() {
  if (pBLEScan == nullptr) {
    Serial.println("BLE Scanner not active.");
    delay(5000);
    return;
  }

  Serial.println("\n--- Starting passive scan cycle ---");
  
  // Non-blocking scan for 5 seconds
  pBLEScan->start(5, false);
  pBLEScan->clearResults(); // Clear results to free internal BLE RAM
  
  // Save current array to flash file system (only if SPIFFS is active)
  if (spiffsActive) {
    saveLogsToSPIFFS();
    printSavedLogs();
  } else {
    // RAM-only printing mode
    Serial.println("\n========== RAM-ONLY LOGS (SPIFFS DISABLED) ==========");
    Serial.print("[\n");
    for (int i = 0; i < deviceCount; i++) {
      Serial.print("  {\n");
      Serial.print("    \"mac\": \"" + deviceLogs[i].mac + "\",\n");
      Serial.print("    \"firstSeen\": " + String(deviceLogs[i].firstSeen) + ",\n");
      Serial.print("    \"lastSeen\": " + String(deviceLogs[i].lastSeen) + ",\n");
      Serial.print("    \"rssiHistory\": [");
      for (int j = 0; j < deviceLogs[i].rssiCount; j++) {
        Serial.print(String(deviceLogs[i].rssiHistory[j]));
        if (j < deviceLogs[i].rssiCount - 1) Serial.print(", ");
      }
      Serial.print("],\n");
      Serial.print("    \"serviceData\": \"" + deviceLogs[i].decodedData + "\"\n");
      Serial.print("  }");
      if (i < deviceCount - 1) Serial.print(",\n");
      else Serial.print("\n");
    }
    Serial.print("]\n");
    Serial.println("=====================================================");
  }
  
  delay(5000); // Wait 5 seconds between scan runs
}


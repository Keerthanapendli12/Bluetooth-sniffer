// Max devices to track in memory to prevent RAM exhaustion
#define MAX_LOGGED_DEVICES 50
#define LOG_FILE_PATH "/ble_log.json"

// Struct for logging BLE devices
struct DeviceLog {
  String mac;
  unsigned long firstSeen;
  unsigned long lastSeen;
  int rssiHistory[10];
  int rssiCount = 0;
  String decodedData;
};

// Global device array
DeviceLog deviceLogs[MAX_LOGGED_DEVICES];
int deviceCount = 0;

BLEScan* pBLEScan = nullptr;
bool spiffsActive = false; // Set to true if SPIFFS mounts successfully

// ==========================================
// BLE Service Decoder
// ==========================================
String decodeServiceData(BLEAdvertisedDevice advertisedDevice) {
  String result = "";
  
  if (advertisedDevice.haveServiceUUID()) {
    BLEUUID uuid = advertisedDevice.getServiceUUID();
    result += "Service UUID: " + String(uuid.toString().c_str()) + " ";
  }
  
  if (advertisedDevice.haveServiceData()) {
    BLEUUID dataUuid = advertisedDevice.getServiceDataUUID();
    String rawData = advertisedDevice.getServiceData();
    
    result += "[Data UUID: " + String(dataUuid.toString().c_str()) + " | Raw: ";
    for (size_t i = 0; i < rawData.length(); i++) {
      char temp[3];
      sprintf(temp, "%02X", (uint8_t)rawData[i]);
      result += temp;
    }
    result += "] ";
    
    // Parse common standard BLE service UUIDs using equals()
    if (dataUuid.equals(BLEUUID((uint16_t)0x180F)) && rawData.length() >= 1) { // Battery Service
      uint8_t batteryLevel = (uint8_t)rawData[0];
      result += "Battery: " + String(batteryLevel) + "%";
    }
    else if (dataUuid.equals(BLEUUID((uint16_t)0x1809)) && rawData.length() >= 2) { // Health Thermometer
      float temp = (float)rawData[0] + (float)rawData[1] / 100.0;
      result += "Temp: " + String(temp, 1) + " C";
    }
    else if (dataUuid.equals(BLEUUID((uint16_t)0x180D)) && rawData.length() >= 2) { // Heart Rate
      uint8_t hr = (uint8_t)rawData[1];
      result += "Heart Rate: " + String(hr) + " bpm";
    }
  }
  
  if (result.length() == 0) {
    result = "No Service Data";
  }
  
  return result;
}

// ==========================================
// SPIFFS File Logger
// ==========================================
void saveLogsToSPIFFS() {
  if (!spiffsActive) {
    Serial.println("Skipping SPIFFS write (SPIFFS not initialized).");
    return;
  }
  
  File file = SPIFFS.open(LOG_FILE_PATH, "w");
  if (!file) {
    Serial.println("Error: Failed to open file for writing in SPIFFS!");
    return;
  }
  
  // Format manual JSON array to bypass library requirements
  file.print("[\n");
  for (int i = 0; i < deviceCount; i++) {
    file.print("  {\n");
    file.print("    \"mac\": \"" + deviceLogs[i].mac + "\",\n");
    file.print("    \"firstSeen\": " + String(deviceLogs[i].firstSeen) + ",\n");
    file.print("    \"lastSeen\": " + String(deviceLogs[i].lastSeen) + ",\n");
    
    // Write RSSI History
    file.print("    \"rssiHistory\": [");
    for (int j = 0; j < deviceLogs[i].rssiCount; j++) {
      file.print(String(deviceLogs[i].rssiHistory[j]));
      if (j < deviceLogs[i].rssiCount - 1) {
        file.print(", ");
      }
    }
    file.print("],\n");
    
    // Write Decoded Service Data
    String escapedData = deviceLogs[i].decodedData;
    escapedData.replace("\"", "\\\""); // Escape quote chars
    file.print("    \"serviceData\": \"" + escapedData + "\"\n");
    
    file.print("  }");
    if (i < deviceCount - 1) {
      file.print(",\n");
    } else {
      file.print("\n");
    }
  }
  file.print("]\n");
  file.close();
  Serial.println("Logs written successfully to " LOG_FILE_PATH);
}

// ==========================================
// Verify SPIFFS Logs (Print to Serial)
// ==========================================
void printSavedLogs() {
  if (!spiffsActive) {
    return;
  }
  
  if (!SPIFFS.exists(LOG_FILE_PATH)) {
    Serial.println("No log file found in SPIFFS.");
    return;
  }
  
  File file = SPIFFS.open(LOG_FILE_PATH, "r");
  if (!file) {
    Serial.println("Failed to open file for reading.");
    return;
  }
  
  Serial.println("\n========== SPIFFS JSON LOG FILE ==========");
  while (file.available()) {
    Serial.write(file.read());
  }
  Serial.println("\n==========================================");
  file.close();
}


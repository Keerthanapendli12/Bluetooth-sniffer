        ctx.shadowColor = "#00F0FF";
        ctx.shadowBlur = 6;
        ctx.beginPath();
        const xStep = w / 29;
        for (let i = 0; i < this.data.length; i++) {
            const x = i * xStep;
            const y = this.mapY(this.data[i], h);
            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
        }
        ctx.stroke();
        
        // Fill gradient
        ctx.shadowBlur = 0;
        ctx.strokeStyle = "transparent";
        const grad = ctx.createLinearGradient(0, 0, 0, h);
        grad.addColorStop(0, "rgba(0, 240, 255, 0.2)");
        grad.addColorStop(1, "rgba(157, 78, 221, 0.0)");
        ctx.fillStyle = grad;
        ctx.lineTo((this.data.length - 1) * xStep, h);
        ctx.lineTo(0, h);
        ctx.closePath();
        ctx.fill();
        
        // Nodes
        ctx.fillStyle = "#9D4EDD";
        ctx.strokeStyle = "#00F0FF";
        ctx.lineWidth = 1.5;
        for (let i = 0; i < this.data.length; i++) {
            const x = i * xStep;
            const y = this.mapY(this.data[i], h);
            ctx.beginPath();
            ctx.arc(x, y, 3, 0, 2 * Math.PI);
            ctx.fill();
            ctx.stroke();
        }
    }
    mapY(rssi, height) {
        const minR = -100, maxR = -30;
        const cl = Math.max(minR, Math.min(maxR, rssi));
        return height - ((cl - minR) / (maxR - minR)) * height;
    }
}

function connectWebSocket() {
    const host = window.location.hostname || "192.168.4.1";
    const wsUrl = `ws://${host}:81`;
    
    console.log(`Connecting to WebSocket: ${wsUrl}`);
    connectionStatus.innerText = "Connecting...";
    statusDot.className = "status-dot offline";

    socket = new WebSocket(wsUrl);

    socket.onopen = () => {
        console.log("WebSocket connected.");
        connectionStatus.innerText = "Connected";
        statusDot.className = "status-dot online";
        if (wsReconnectTimer) {
            clearInterval(wsReconnectTimer);
            wsReconnectTimer = null;
        }
    };

    socket.onmessage = (event) => {
        try {
            const packet = JSON.parse(event.data);
            handleIncomingPacket(packet);
        } catch (e) {
            console.error("Failed to parse JSON", e);
        }
    };

    socket.onclose = () => {
        console.warn("WebSocket closed. Reconnecting...");
        connectionStatus.innerText = "Disconnected";
        statusDot.className = "status-dot offline";
        if (!wsReconnectTimer) {
            wsReconnectTimer = setInterval(connectWebSocket, 3000);
        }
    };

    socket.onerror = (err) => {
        console.error("WebSocket error:", err);
    };
}

function handleIncomingPacket(packet) {
    packetCount++;
    packetsThisSecond++;
    
    const mac = packet.mac;
    const now = Date.now();
    
    if (!devices.has(mac)) {
        devices.set(mac, {
            mac: mac,
            name: packet.name || "Unknown",
            rssiHistory: [],
            type: classifyDevice(packet),
            packetCount: 0,
            firstSeen: now,
            lastSeen: now,
            raw: packet.raw,
            len: packet.len
        });
        updateGraphSelector();
    }
    
    const dev = devices.get(mac);
    dev.rssi = packet.rssi;
    dev.lastSeen = now;
    dev.packetCount++;
    dev.raw = packet.raw;
    dev.len = packet.len;
    if (packet.name && packet.name !== "Unknown") {
        dev.name = packet.name;
    }
    
    dev.rssiHistory.push({ t: now, y: packet.rssi });
    if (dev.rssiHistory.length > 50) {
        dev.rssiHistory.shift();
    }
    
    renderTable();
    updateStats();
    
    if (selectedMac === mac) {
        updateInspector(dev);
        appendChartData(now, packet.rssi);
    }
}

function classifyDevice(packet) {
    const name = (packet.name || "").toLowerCase();
    const raw = packet.raw || "";
    if (raw.includes("4C000215") || raw.includes("0303AAFE") || raw.includes("1AFF4C000215")) return "Beacon";
    if (name.includes("watch") || name.includes("fitbit") || name.includes("band") || name.includes("buds") || name.includes("smart")) return "Wearable";
    if (name.includes("temp") || name.includes("hum") || name.includes("sensor") || name.includes("tag") || name.includes("batt")) return "Sensor";
    if (name.includes("iphone") || name.includes("galaxy") || name.includes("phone") || name.includes("android")) return "Mobile";
    return "BLE Device";
}

function decodePayload(hexStr) {
    if (!hexStr || hexStr.length === 0) return [];
    const fields = [];
    let idx = 0;
    const bytes = [];
    for (let i = 0; i < hexStr.length; i += 2) {
        bytes.push(parseInt(hexStr.substring(i, i + 2), 16));
    }
    
    while (idx < bytes.length) {
        const len = bytes[idx];
        if (len === 0 || idx + len >= bytes.length) break;
        const type = bytes[idx + 1];
        const data = bytes.slice(idx + 2, idx + 1 + len);
        let label = "Unknown Type";
        let val = "";
        
        switch (type) {
            case 0x01:
                label = "Flags";
                const flags = data[0];
                const list = [];
                if (flags & 0x01) list.push("LE Limited");
                if (flags & 0x02) list.push("LE General");
                if (flags & 0x04) list.push("BR/EDR Not Supported");
                val = list.join(" | ") || `0x${flags.toString(16)}`;
                break;
            case 0x03:
                label = "16-bit Service UUIDs";
                const uuids16 = [];
                for (let i = 0; i < data.length; i += 2) {
                    if (i + 1 < data.length) {
                        const uuid = ((data[i+1] << 8) | data[i]).toString(16).toUpperCase().padStart(4, '0');
                        uuids16.push(`0x${uuid}`);
                    }
                }
                val = uuids16.join(", ");
                break;
            case 0x08:
            case 0x09:
                label = "Local Name";
                val = String.fromCharCode.apply(null, data);
                break;
            case 0x0A:
                label = "Tx Power Level";
                const pwr = data[0] > 127 ? data[0] - 256 : data[0];
                val = `${pwr} dBm`;
                break;
            case 0xFF:
                label = "Manufacturer Data";
                if (data.length >= 2) {
                    const companyId = (data[1] << 8) | data[0];
                    let compName = mapCompanyId(companyId);
                    let subHex = bytesToHex(data.slice(2));
                    val = `Company: ${compName} (0x${companyId.toString(16).toUpperCase().padStart(4, '0')})`;
                    
                    if (companyId === 0x004C && data[2] === 0x02 && data[3] === 0x15) {
                        label = "iBeacon Packet";
                        const uuid = bytesToHex(data.slice(4, 20)).match(/.{1,8}/g).join('-');
                        const major = (data[20] << 8) | data[21];
                        const minor = (data[22] << 8) | data[23];
                        const txPower = data[24] > 127 ? data[24] - 256 : data[24];
                        val = `UUID: ${uuid}<br>Major: ${major}<br>Minor: ${minor}<br>Tx Power: ${txPower} dBm`;
                    } else if (subHex.length > 0) {
                        val += `<br>Payload: <span class="mono">${subHex}</span>`;
                    }
                } else {
                    val = bytesToHex(data);
                }
                break;
            default:
                label = `Type 0x${type.toString(16).toUpperCase().padStart(2, '0')}`;
                val = bytesToHex(data);
                break;
        }
        fields.push({ label, val });
        idx += len + 1;
    }
    return fields;
}

function bytesToHex(bytes) { return bytes.map(b => b.toString(16).padStart(2, '0').toUpperCase()).join(' '); }
function mapCompanyId(id) {
    const companies = { 0x004C: "Apple", 0x0006: "Microsoft", 0x00E0: "Google", 0x0059: "Nordic", 0x0075: "Samsung" };
    return companies[id] || "Unknown Corp";
}


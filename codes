    draw() {
        const ctx = this.ctx;
        const w = this.canvas.clientWidth;
        const h = this.canvas.clientHeight;
        this.canvas.width = w;
        this.canvas.height = h;
        ctx.clearRect(0, 0, w, h);
        
        // Draw grid
        ctx.strokeStyle = "rgba(255, 255, 255, 0.05)";
        ctx.lineWidth = 1;
        const yLines = [-30, -50, -70, -90];
        yLines.forEach(dbm => {
            const y = this.mapY(dbm, h);
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(w, y);
            ctx.stroke();
            ctx.fillStyle = "#94A3B8";
            ctx.font = "10px Outfit";
            ctx.fillText(`${dbm} dBm`, 5, y - 4);
